php_value date.timezone 'America/Mexico_City'

RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.siutitsm\.com\.mx [NC]
RewriteRule ^(.*)$ https://siutitsm.com.mx/$1 [L,R=301]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]


<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Bloquear acceso a archivos sensibles
    <FilesMatch "\.(latte|env|log|ini)$">
        Require all denied
    </FilesMatch>

    # Opcional: Quitar extensión .php de la URL
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>