{extends ../templates/@landing.latte}
{varType App\Modules\Transparency\Domain\Entity\Transparency[] $documents}
{varType array $attachmentsByDoc}
{varType bool $isAuthenticated}
{block main}
<section class="py-5" id="about">
  <div class="container pt-5">
    <div class="row mb-4">
      <h1 data-aos="fade-up" data-aos-delay="0" class="text-uppercase fw-bold">
        Transparencia
      </h1>
    </div>
    <div class="row">
      <div class="col-md-6 order-md-2">
        <div class="row justify-content-end">
          <div class="col-md-11 mb-4 mb-md-0">
            <span class="d-block text-uppercase small text-muted mb-3" data-aos="fade-up" data-aos-delay="0">Transparencia</span>
            <h2 class="mb-4" data-aos="fade-up" data-aos-delay="100">Vínculos Normativos</h2>
            <div data-aos="fade-up" data-aos-delay="200">
              <p>

              </p>
            </div>
            <h2 class="mb-4 mt-5" data-aos="fade-up" data-aos-delay="500">Contacto para Consultas</h2>
            <div data-aos="fade-up" data-aos-delay="600">
              <p>Si tienes alguna pregunta o necesitas información adicional, no dudes en contactarnos a
                través de
                nuestro correo electrónico: 
                <a href="mailto:Sindicato_SIUTITSM@outlook.com" class="text-lowercase">Sindicato_SIUTITSM@outlook.com</a> o llamarnos al teléfono: 
                <a href="tel:+52-993-106-6169" class="text-lowercase">936 106 61 69.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 order-md-1">
        <div class="row justify-content-start">
          <div class="col-md-11">
            <div class="row">
              <a href="https://tabasco.gob.mx/buen-gobierno" target="_blank" rel="noopener noreferrer">
                <img src="/assets/images/logo/LOGOESC-BUEN-GOBIERNO.png" alt="Logo del Buen Gobierno Tabasco" class="img-fluid rounded"
                  data-aos="fade-up" data-aos-delay="700">
              </a>
            </div>
            <div class="row">
              <a href="https://www.gob.mx/buengobierno" target="_blank" rel="noreferrer noopener">
                <img src="/assets/images/logo/secretaria-anticorrupcion-y-buen-gobierno.webp" alt="Logo de la Secretaría de Transparencia" class="img-fluid rounded mt-4"
                  data-aos="fade-up" data-aos-delay="800">
              </a>
            </div>
                        <div class="row">
              <a href="https://osfetabasco.gob.mx/" target="_blank" rel="noreferrer noopener">
                <img src="/assets/images/logo/osfe.png" alt="Logo de la OSFE" class="img-fluid rounded mt-4"
                  data-aos="fade-up" data-aos-delay="800">
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/block}