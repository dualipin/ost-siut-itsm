{extends ../templates/@landing.latte}
{varType array $documentsByYear}
{varType array $documentVisibility}
{varType bool $isAuthenticated}
{block main}
<section class="py-5 mt-5">
  <div class="container pt-4">
    <div class="row justify-content-center mb-4">
      <div class="col-12 col-xl-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
          <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
              <div>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary mb-3">Transparencia pública</span>
                <h1 class="display-6 fw-bold mb-3">Documentos organizados por año y mes</h1>
                <p class="lead text-secondary mb-0">
                  Explora el archivo cronológico de documentos. Los registros privados se muestran en el listado,
                  pero solo habilitan el detalle cuando tu sesión tiene permisos.
                </p>
              </div>

              <div class="text-lg-end">
                <div class="d-inline-flex align-items-center gap-2 bg-light rounded-pill px-3 py-2 mb-2">
                  <i class="bi bi-calendar3 text-primary"></i>
                  <span class="small fw-semibold">Año → Mes → Documento</span>
                </div>
                <div class="small text-muted">Vista responsive con acordeón multinivel</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center mb-4">
      <div class="col-12 col-xl-10">
        <div class="row row-cols-1 row-cols-md-3 g-4">
          <div class="col">
            <a href="https://tabasco.gob.mx/buen-gobierno" target="_blank" rel="noopener noreferrer" class="d-block text-decoration-none">
              <img src="/assets/images/logo/LOGOESC-BUEN-GOBIERNO.png" alt="Logo del Buen Gobierno Tabasco" class="img-fluid rounded-4 shadow-sm w-100" width="420" height="210">
            </a>
          </div>
          <div class="col">
            <a href="https://www.gob.mx/buengobierno" target="_blank" rel="noreferrer noopener" class="d-block text-decoration-none">
              <img src="/assets/images/logo/secretaria-anticorrupcion-y-buen-gobierno.webp" alt="Logo de la Secretaría de Transparencia" class="img-fluid rounded-4 shadow-sm w-100" width="420" height="210">
            </a>
          </div>
          <div class="col">
            <a href="https://osfetabasco.gob.mx/" target="_blank" rel="noreferrer noopener" class="d-block text-decoration-none">
              <img src="/assets/images/logo/osfe.png" alt="Logo de la OSFE" class="img-fluid rounded-4 shadow-sm w-100" width="420" height="210">
            </a>
          </div>
        </div>
      </div>
    </div>

    {if empty($documentsByYear)}
      <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
          <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body py-5 text-center text-muted">
              <i class="bi bi-inbox fs-1 d-block mb-3"></i>
              <h2 class="h4 mb-2">Aún no hay documentos publicados</h2>
              <p class="mb-0">Cuando exista nuevo contenido, aparecerá agrupado por año y mes.</p>
            </div>
          </div>
        </div>
      </div>
    {else}
      <div class="row row-cols-1 row-cols-md-2 g-4">
        {foreach $documentsByYear as $year => $months}
          <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
              <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingYear{$year}">
                  <button class="accordion-button collapsed fs-4 fw-bold py-4"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapseYear{$year}"
                          aria-expanded="false"
                          aria-controls="collapseYear{$year}">
                    <span class="d-flex w-100 align-items-center justify-content-between gap-3">
                      <span class="d-flex align-items-center gap-3 text-start">
                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary">{$year}</span>
                        <span>Documentos del año {$year}</span>
                      </span>
                      <span class="badge rounded-pill bg-light text-dark">{count($months)} mes(es)</span>
                    </span>
                  </button>
                </h2>

                <div id="collapseYear{$year}"
                   class="accordion-collapse collapse"
                     aria-labelledby="headingYear{$year}">
                  <div class="card-body bg-light bg-opacity-25 p-3 p-md-4">
                    <div class="accordion" id="accordionMonths{$year}">
                      {foreach $months as $monthNumber => $monthData}
                        <div class="accordion-item border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                          <h3 class="accordion-header" id="headingMonth{$year}{$monthNumber}">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseMonth{$year}{$monthNumber}"
                                    aria-expanded="false"
                                    aria-controls="collapseMonth{$year}{$monthNumber}">
                              <span class="d-flex w-100 align-items-center justify-content-between gap-3">
                                <span class="text-start text-capitalize">{$monthData['label']}</span>
                                <span class="badge rounded-pill bg-light text-dark">{count($monthData['documents'])} documento(s)</span>
                              </span>
                            </button>
                          </h3>

                          <div id="collapseMonth{$year}{$monthNumber}"
                               class="accordion-collapse collapse"
                               aria-labelledby="headingMonth{$year}{$monthNumber}"
                               data-bs-parent="#accordionMonths{$year}">
                            <div class="accordion-body bg-white p-3 p-md-4">
                              <div class="d-grid gap-3">
                                {foreach $monthData['documents'] as $document}
                                  <article class="border rounded-4 p-3 p-md-4 bg-white">
                                    <div class="d-flex flex-column flex-md-row gap-3 justify-content-between">
                                      <div class="d-flex gap-3">
                                        <div class="min-w-0">
                                          <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                            <h4 class="h5 mb-0">{$document->title}</h4>
                                            <span class="badge rounded-pill bg-info text-dark bg-opacity-25">{$document->type->value}</span>
                                          </div>

                                          <div class="small text-muted d-flex flex-wrap gap-3">
                                            <span><i class="bi bi-calendar-event me-1"></i>{$document->datePublished->format('d/m/Y')}</span>
                                            <span><i class="bi bi-clock-history me-1"></i>{$document->createdAt->format('d/m/Y H:i')}</span>
                                          </div>

                                          {if $document->summary && $documentVisibility[$document->id]}
                                            <p class="mb-0 mt-3 text-secondary">{$document->summary}</p>
                                          {elseif $document->isPrivate}
                                            <p class="mb-0 mt-3 text-muted">...</p>
                                          {/if}
                                        </div>
                                      </div>

                                      <div class="d-flex align-items-start">
   
                                          <a href="/portal/transparencia/detalle.php?id={$document->id}" class="btn btn-outline-primary rounded-4 text-nowrap">
                                            <i class="bi bi-eye me-1"></i> Ver detalle
                                          </a>
  
                                      </div>
                                    </div>
                                  </article>
                                {/foreach}
                              </div>
                            </div>
                          </div>
                        </div>
                      {/foreach}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {/foreach}
      </div>
    {/if}
  </div>
</section>

{/block}