{extends ../templates/@landing.latte}

{varType App\Module\Prestamo\Entity\CategoriaTipoIngreso[] $categoriasTipoIngreso}
{varType string $prestamistaNombre}
{varType bool $isNoAgremiado}

{block main}
  <div class="container py-5">
    {include
      ../templates/components/header-page.latte,
      title => 'Simular Préstamo',
      description => "Ingresa el monto del préstamo para obtener una estimación de tus pagos futuros.",
      icon => 'bi-calculator'
    }

    <div x-data="simuladorData()">
      <form class="needs-validation" method="POST">

        <div class="row mb-3">
          <div class="col-md-4 mb-3">
            <label class="form-label">Perfil (Tasa de Interés)</label>
            <select class="form-select" @change="onPerfilChange($event.target.value)">
              <option value="" disabled selected>Selecciona un perfil...</option>
                <option value="8.0">No agremiado y ahorrador (Externo) (8%)</option>
                <option value="9.5">No agremiado y no ahorrador (Externo) (9.5%)</option>
                <option value="6.0">Agremiado y ahorrador (6%)</option>
                <option value="7.5">Agremiado y no ahorrador (7.5%)</option>
            </select>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label">Tasa Mensual (%)</label>
            <span class="form-control-plaintext fw-bold" x-text="tasaInteresMensual.toFixed(2) + '%'"></span>
            <input type="hidden" name="tasa_interes" x-model="tasaInteresMensual" class="form-control" step="0.1"
                   required>
          </div>
          <div class="col-md-4 mb-3">
            <label for="fechaOtorgamiento" class="form-label">Fecha de Inicio</label>
            <input type="date" id="fechaOtorgamiento" class="form-control" x-model="fechaOtorgamiento" required>
          </div>
        </div>

        <!-- Total solicitado (grande) -->
        <div class="text-center mb-4 position-sticky bg-body py-3"
             style="z-index: 10; border-bottom: 1px solid #dee2e6; top: 3.8em">
          <div class="fw-bold text-primary" x-text="formatCurrency(totalSolicitado)"
               style="font-size: clamp(1.5rem, 6vw, 3rem);"></div>
          <div class="small text-muted">Monto del Préstamo</div>
          <div class="mt-2">
            <small class="text-muted d-block">Fecha actual</small>
            <span class="badge bg-secondary" x-text="localize(currentDate)"></span>
          </div>
          <div class="mt-1">
            <small class="text-muted"
                   x-text="`Plazo estimado: ${ mesesEstimados } mes(es) + ${ diasEstimados } día(s)`"></small>
          </div>
        </div>

        <template x-for="(item, index) in descuentos">
          <div class="card mb-3 p-3">
            <div class="d-flex flex-column flex-md-row align-items-start gap-2 row">
              <div class="flex-fill">
                <div class="row g-2">
                  <div class="col-12 col-sm-6">
                    <label class="form-label mb-1 small d-none d-sm-block">Monto</label>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <input x-model.number="item.monto" type="number" class="form-control" min="0" placeholder="0.00"
                             aria-label="Monto del descuento">
                      <span class="input-group-text">.00</span>
                    </div>
                  </div>

                  <div class="col-12 col-sm-6">
                    <label class="form-label mb-1 small d-none d-sm-block">Con cargo a</label>
                    <select x-model.number="item.tipoId" @change="onTipoChange(index)" class="form-select" required>
                      <option value="0" selected disabled>Seleccione...</option>
                      <template x-for="dato in categoriasTipoIngreso">
                        <option :value="dato.id" x-text="dato.nombre"
                                :disabled="!dato.activo || tipoEstaSeleccionado(dato.id, item.tipoId) || fechaTentativaVencida(dato)"></option>
                      </template>
                    </select>
                  </div>

                  <div class="col-12"
                       x-show="item.tipoId && (categoriasTipoIngreso.find(c => Number(c.id) === Number(item.tipoId))?.esPeriodico)">
                    <div class="row g-2">
                      <div class="col-12 col-sm-4">
                        <label class="form-label mb-1 small">Inicio del préstamo</label>
                        <div class="form-control-plaintext fw-semibold" x-text="localize(fechaOtorgamiento)"></div>
                      </div>
                      <div class="col-12 col-sm-4">
                        <label class="form-label mb-1 small">Primer quincena</label>
                        <div class="form-control-plaintext fw-semibold"
                             x-text="calcularPrimeraQuincena()">
                        </div>
                      </div>
                      <div class="col-12 col-sm-4">
                        <label class="form-label mb-1 small">Fecha de último pago</label>
                        <select x-model="item.fechaPago" @change="onFechaPagoChange(index)" class="form-select"
                                :disabled="obtenerOpcionesParaItem(index).length === 0">
                          <option value="">Seleccione una fecha...</option>
                          <template x-for="op in obtenerOpcionesParaItem(index)">
                            <option :value="op.value" x-text="op.label"></option>
                          </template>
                        </select>
                      </div>
                      {* <div class="col-6 col-sm-4">
                        <label class="form-label mb-1 small">Unidad</label>
                        <div class="form-control-plaintext small"
                             x-text="`Cada ${ categoriasTipoIngreso.find(c => Number(c.id) === Number(item.tipoId))?.frecuenciaDias } días`">
                        </div>
                      </div> *}
                      {* <div class="col-6 col-sm-4">
                        <label class="form-label mb-1 small">Períodos</label>
                        <div class="form-control-plaintext fw-semibold" x-text="item.cantidad || 0"></div>
                        <div class="small text-muted">Máx períodos: <span
                                  x-text="calcularMaxPeriodos(categoriasTipoIngreso.find(c => Number(c.id) === Number(item.tipoId)))"></span>
                        </div>
                      </div> *}
                      {* <div class="col-12">
                        <label class="form-label mb-1 small">Fecha aproximada de terminación</label>
                        <div class="form-control-plaintext fw-semibold"
                             x-text="item.fechaPago ? localize(item.fechaPago) : '-'">
                        </div>
                      </div> *}
                    </div>
                  </div>
                </div>
              </div>
              <div class="d-flex flex-column align-items-lg-end">
                <button type="button" class="btn btn-outline-danger" @click.prevent="eliminar(index)"
                        title="Eliminar">
                  <i class="bi bi-x-lg"></i>
                  <span class="d-none d-md-inline ms-1">Eliminar</span>
                </button>
              </div>
            </div>
          </div>
        </template>

        <!-- Campo oculto con JSON de descuentos -->
        <input type="hidden" name="descuentos_json" :value="JSON.stringify(descuentos)">
        <input type="hidden" name="prestamista_nombre" :value="prestamistaNombre">
        <input type="hidden" name="monto_prestamo" :value="totalSolicitado">
        <input type="hidden" name="fecha_otorgamiento" :value="fechaOtorgamiento">
        <input type="hidden" name="meses_pagar" :value="mesesEstimados">
        <input type="hidden" name="dias_adicionales" :value="diasEstimados">

        <div class="d-grid gap-2 d-sm-flex mb-3">
          <div class="me-sm-2" style="width:64px;">
            <button type="button" class="btn btn-outline-secondary w-100 h-100" @click.prevent="agregar()"
                    :disabled="!puedeAgregar" aria-label="Agregar descuento">
              <i class="bi bi-plus" style="font-size: 1.25rem;"></i>
            </button>
          </div>
          <div class="flex-fill">
            <button class="btn btn-outline-danger btn-lg w-100" type="submit" name="output" value="pdf">
              Descargar PDF
            </button>
          </div>
        </div>
      </form>
    </div>

    <div class="alert alert-warning mt-4" role="alert">
      Aquellos no miembros que deseen un préstamo, presentarse con un representante o acudir a las oficinas y mostrar el archivo de la simulación.
    </div>
  </div>

  <script>
    /**
     * @typedef { Object } TipoPrestamoRaw
     * @property { number } id
     * @property { string } nombre
     * @property { boolean } esPeriodico
     * @property { number } frecuenciaDias
     * @property { number } mesPagoTentativo
     * @property { number } diasPagoTentativo
     * @property { boolean } activo
     */

    /**
     * @typedef { Object } DescuentoItem
     * @property { number } monto
     * @property { string | number } tipoId
     * @property { number } cantidad
     * @property { string } fechaPago
     * @property { string } unidad
     */

    class TipoPrestamo {
      /**
       * @param { number } id
       * @param { string } nombre
       * @param { boolean } esPeriodico
       * @param { number } frecuenciaDias
       * @param { number } mesPagoTentativo
       * @param { number } diasPagoTentativo
       * @param { boolean } activo
       */
      constructor (id, nombre, esPeriodico, frecuenciaDias, mesPagoTentativo, diasPagoTentativo, activo) {
        this.id = id
        this.nombre = nombre
        this.esPeriodico = esPeriodico
        this.frecuenciaDias = frecuenciaDias
        this.mesPagoTentativo = mesPagoTentativo
        this.diasPagoTentativo = diasPagoTentativo
        this.activo = activo
      }
    }

    function obtenerCorte(){}

    /**
     * @returns { Object }
     */
    function simuladorData () {
      const isNoAgremiado = {= $isNoAgremiado ? 'true' : 'false'}
      const data = {= json_encode($categoriasTipoIngreso)};
      /** @type { TipoPrestamoRaw[] } */
      const parsed = typeof data === 'string' ? JSON.parse(data) : data
      /** @type { TipoPrestamoRaw[] } */
      const dataTipoPrestamos = Array.isArray(parsed) ? parsed : []

      /** @type { TipoPrestamo[] } */
      const tiposPrestamos = dataTipoPrestamos.map((item) => new TipoPrestamo(
        Number(item.id),
        item.nombre,
        item.esPeriodico,
        item.frecuenciaDias,
        item.mesPagoTentativo,
        item.diasPagoTentativo,
        item.activo,
      ))

      /** @type { () => DescuentoItem } */
      const buildDescuento = () => ({
        monto: 0,
        tipoId: 0,
        cantidad: 1,
        fechaPago: '',
        unidad: 'meses',
      })

      return {
        prestamistaNombre: {= json_encode($prestamistaNombre)},
        tasaInteresMensual: isNoAgremiado ? 9.5 : 7.5,
        fechaOtorgamiento: (function () {
          const d = new Date()
          const y = d.getFullYear()
          const m = String(d.getMonth() + 1).padStart(2, '0')
          const day = String(d.getDate()).padStart(2, '0')
          return y + '-' + m + '-' + day
        })(),
        onPerfilChange (val) {
          this.tasaInteresMensual = parseFloat(val) || this.tasaInteresMensual
        },
        /**
         * Calcula la tasa diaria a partir de la tasa mensual
         * Fórmula: i_diaria = tasa_mensual / 30
         * @returns { number }
         */
        get tasaDiaria () {
          return this.tasaInteresMensual / 100 / 30
        },
        /**
         * @type { TipoPrestamo[] }
         */
        tiposPrestamos,
        /**
         * @type { () => TipoPrestamo[] }
         * @return { TipoPrestamo[] }
         */
        tiposPrestamosDisponibles () {
          return this.tiposPrestamos.filter(tp => tp.activo)
        },
        /** @type { DescuentoItem[] } */
        descuentos: [buildDescuento()],
        /** @type { string } */
        currentDate: (function () {
          const d = new Date()
          const y = d.getFullYear()
          const m = String(d.getMonth() + 1).padStart(2, '0')
          const day = String(d.getDate()).padStart(2, '0')
          return y + '-' + m + '-' + day
        })(),

        /**
         * @type { TipoPrestamo[] }
         */
        categoriasTipoIngreso: tiposPrestamos,
        /**
         * Calcula la fecha de la primera quincena respetando tolerancia de 10 días
         * Si estamos a MENOS de 10 días de una quincena, la saltamos (período muy corto)
         * @returns { string }
         */
        calcularPrimeraQuincena () {
          const fecha = new Date(this.fechaOtorgamiento + 'T00:00:00')
          const dia = fecha.getDate()
          const mes = fecha.getMonth()
          const ano = fecha.getFullYear()
          
          // Tolerancia: 10 días mínimo entre hoy y la quincena para usarla
          const tolerancia = 10
          
          // Quincenas posibles: día 15 y último día del mes
          const dia15 = new Date(ano, mes, 15)
          const ultimoDia = new Date(ano, mes + 1, 0)
          
          // Si aún no hemos llegado al día 15
          if (dia < 15) {
            const diasHasta15 = Math.floor((dia15.getTime() - fecha.getTime()) / 86400000)
            
            // Si estamos a 10 o más días del 15, esa es nuestra quincena
            if (diasHasta15 >= tolerancia) {
              return dia15.toLocaleDateString('es-MX')
            }
            
            // Si estamos a menos de 10 días del 15, saltamos al último día
            return ultimoDia.toLocaleDateString('es-MX')
          }
          
          // Si ya pasamos el día 15
          if (dia >= 15) {
            const diasHastaUltimoDia = Math.floor((ultimoDia.getTime() - fecha.getTime()) / 86400000)
            
            // Si estamos a 10 o más días del último día, esa es nuestra quincena
            if (diasHastaUltimoDia >= tolerancia) {
              return ultimoDia.toLocaleDateString('es-MX')
            }
            
            // Si estamos a menos de 10 días del último día, saltamos al 15 del próximo mes
            const nextMonth = new Date(ano, mes + 1, 15)
            return nextMonth.toLocaleDateString('es-MX')
          }
        },
        obtenerFechaMaximaAnual () {
          const hoy = new Date()
          const anioActual = hoy.getFullYear()
          // Fecha límite operativa para opciones de pago periódico.
          return new Date(anioActual, 10, 15) // 15 de noviembre
        },
        /**
         * @param { Date } date
         * @returns { string }
         */
        toIsoDate (date) {
          const y = date.getFullYear()
          const m = String(date.getMonth() + 1).padStart(2, '0')
          const d = String(date.getDate()).padStart(2, '0')
          return `${ y }-${ m }-${ d }`
        },
        /**
         * @param { Date } date
         * @returns { string }
         */
        toDisplayDate (date) {
          return date.toLocaleDateString('es-MX')
        },
        get selectedTipoIds () {
          return this.descuentos.map(d => Number(d.tipoId)).filter(Boolean)
        },
        /**
         * @param { number | string } tipoId
         * @param { number | string } currentTipoId
         * @returns { boolean }
         */
        tipoEstaSeleccionado (tipoId, currentTipoId) {
          return this.selectedTipoIds.includes(Number(tipoId)) && Number(currentTipoId) !== Number(tipoId)
        },
        /**
         * @param { TipoPrestamo | undefined } cat
         * @returns { Date | null }
         */
        obtenerFechaTentativaPago (cat) {
          if (!cat) return null

          const mes = Number(cat.mesPagoTentativo)
          const dia = Number(cat.diasPagoTentativo)
          if (!mes || !dia) return null

          const hoy = new Date(this.currentDate + 'T00:00:00')
          return new Date(hoy.getFullYear(), mes - 1, dia)
        },
        /**
         * @param { TipoPrestamo | undefined } cat
         * @returns { boolean }
         */
        fechaTentativaVencida (cat) {
          const fechaTentativa = this.obtenerFechaTentativaPago(cat)
          if (!fechaTentativa) return false

          const hoy = new Date(this.currentDate + 'T00:00:00')
          return fechaTentativa < hoy
        },
        /** @returns { void } */
        agregar () {
          const disponible = this.categoriasTipoIngreso.find(c => c.activo && !this.selectedTipoIds.includes(c.id) && !this.fechaTentativaVencida(c))
          if (disponible) this.descuentos.push(buildDescuento())
        },
        /** @param { number } index */
        eliminar (index) {
          this.descuentos.splice(index, 1)
        },
        /** @param { number } index */
        onTipoChange (index) {
          const id = Number(this.descuentos[index].tipoId)
          const cat = this.categoriasTipoIngreso.find(c => c.id === id)
          if (cat && cat.esPeriodico) {
            this.descuentos[index].unidad = (cat.frecuenciaDias === 15 ? 'quincenas' : 'meses')
            const opciones = this.obtenerOpcionesFechasPago(cat)
            const ultimaOpcion = opciones.length > 0 ? opciones[opciones.length - 1] : null
            this.descuentos[index].fechaPago = ultimaOpcion ? ultimaOpcion.value : ''
            this.descuentos[index].cantidad = ultimaOpcion ? opciones.length : 0
            const maxPeriodos = opciones.length
            if (window.Alpine && Alpine.store('toast')) {
              Alpine.store('toast').show({
                message: `Tipo periódico: ${ cat.nombre }. Máx períodos: ${ maxPeriodos }`,
                type: 'alert',
              })
            }
          } else {
            delete this.descuentos[index].unidad
            delete this.descuentos[index].cantidad
            delete this.descuentos[index].fechaPago
          }
        },
        /**
         * @param { number } index
         * @returns { void }
         */
        onFechaPagoChange (index) {
          const item = this.descuentos[index]
          const id = Number(item.tipoId)
          const cat = this.categoriasTipoIngreso.find(c => c.id === id)
          if (!cat || !cat.esPeriodico) return

          const opciones = this.obtenerOpcionesFechasPago(cat)
          const idx = opciones.findIndex(op => op.value === item.fechaPago)
          item.cantidad = idx >= 0 ? idx + 1 : 0
        },
        /**
         * Obtiene las opciones de fecha de pago para un item específico
         * @param { number } index
         * @returns { { value: string, label: string }[] }
         */
        obtenerOpcionesParaItem (index) {
          const item = this.descuentos[index]
          if (!item || !item.tipoId) return []
          const cat = this.categoriasTipoIngreso.find(c => c.id === Number(item.tipoId))
          if (!cat || !cat.esPeriodico) return []
          return this.obtenerOpcionesFechasPago(cat)
        },
        /**
         * @param { number } year
         * @param { number } monthIndex
         * @returns { number }
         */
        diasEnMes (year, monthIndex) {
          return new Date(year, monthIndex + 1, 0).getDate()
        },
        /**
         * Calcula los días naturales entre dos fechas (ISO)
         * @param { string } fechaInicio - Formato: YYYY-MM-DD
         * @param { string } fechaFin - Formato: YYYY-MM-DD
         * @returns { number }
         */
        calcularDiasEntreFechas (fechaInicio, fechaFin) {
          const inicio = new Date(fechaInicio + 'T00:00:00')
          const fin = new Date(fechaFin + 'T00:00:00')
          const diffMs = fin.getTime() - inicio.getTime()
          return Math.floor(diffMs / 86400000)
        },
        /**
         * Calcula el interés exacto para un período basado en días reales
         * Fórmula: I = Saldo × i_diaria × n (donde n es número de días)
         * @param { number } saldo
         * @param { number } diasReales
         * @returns { number }
         */
        calcularInteresDiario (saldo, diasReales) {
          return saldo * this.tasaDiaria * diasReales
        },
        /**
         * @param { TipoPrestamo | undefined } cat
         * @returns { { value: string, label: string }[] }
         */
        obtenerOpcionesFechasPago (cat) {
          if (!cat || !cat.esPeriodico) return []

          const frecuencia = Number(cat.frecuenciaDias) || 30
          const diaPago = Number(cat.diasPagoTentativo) || 15
          const inicio = new Date(this.fechaOtorgamiento + 'T00:00:00')
          const fechaMaxima = this.obtenerFechaMaximaAnual()

          if (inicio > fechaMaxima) return []

          const opciones = []

          let cursor = new Date(inicio.getFullYear(), inicio.getMonth(), 1)
          let guard = 0

          while (cursor <= fechaMaxima && guard < 36) {
            // la condición permite que se aplique una tolerancia de 15 días si la fecha está próxima
            // ej. si hoy es 28 de mayo, la quincena del 31 de mayo está a solo 3 días (se salta),
            // por lo tanto la siguiente quincena disponible será el 15 de junio.


            const year = cursor.getFullYear()
            const monthIndex = cursor.getMonth()
            const totalDiasMes = this.diasEnMes(year, monthIndex)

            // Regla requerida: veces en el mes = frequency_days / total de días del mes.
            const fraccionMensual = frecuencia / totalDiasMes
            const vecesEnMes = fraccionMensual > 0 ? Math.max(1, Math.round(1 / fraccionMensual)) : 1
            const diaBase = Math.min(Math.max(1, diaPago), totalDiasMes)
            const saltoDias = Math.max(1, Math.round(totalDiasMes / vecesEnMes))

            for (let i = 0; i < vecesEnMes; i++) {
              const diaCandidato = diaBase + (i * saltoDias)
              if (diaCandidato > totalDiasMes) break

              const fechaPago = new Date(year, monthIndex, diaCandidato)
              const diffMs = fechaPago.getTime() - inicio.getTime()
              const diffDays = Math.floor(diffMs / 86400000)

              if (diffDays < 15 || fechaPago > fechaMaxima) continue

              opciones.push({
                value: this.toIsoDate(fechaPago),
                label: this.toDisplayDate(fechaPago),
              })
            }

            cursor = new Date(year, monthIndex + 1, 1)
            guard++
          }

          return opciones
        },
        /**
         * @param { TipoPrestamo | undefined } cat
         * @returns { number }
         */
        calcularMaxPeriodos (cat) {
          if (!cat || !cat.esPeriodico) return 0
          return this.obtenerOpcionesFechasPago(cat).length
        },
        /**
         * @param { TipoPrestamo | undefined } cat
         * @param { number | string } cantidad
         * @returns { string }
         */
        calcularFechaFin (cat, cantidad) {
          if (!cat || !cat.esPeriodico || !(Number(cantidad) > 0)) return '-'

          const numCuotas = Math.max(1, Number(cantidad))
          const opciones = this.obtenerOpcionesFechasPago(cat)
          if (opciones.length === 0) return '-'

          const idx = Math.min(opciones.length, numCuotas) - 1
          const fechaFin = new Date(opciones[idx].value + 'T00:00:00')

          // Verificar que no supere la fecha máxima anual
          const fechaMaxima = this.obtenerFechaMaximaAnual()
          if (fechaFin > fechaMaxima) {
            return fechaMaxima.toLocaleDateString('es-MX')
          }

          return fechaFin.toLocaleDateString('es-MX')
        },
        get totalSolicitado () {
          return this.descuentos.reduce((s, d) => s + (Number(d.monto) || 0), 0)
        },
        get plazoDiasEstimado () {
          let maxDias = 0
          this.descuentos.forEach((d) => {
            const tipoId = Number(d.tipoId)
            const cat = this.categoriasTipoIngreso.find(c => c.id === tipoId)
            if (!cat) return

            if (cat.esPeriodico) {
              const base = new Date(this.fechaOtorgamiento + 'T00:00:00')
              const opciones = this.obtenerOpcionesFechasPago(cat)
              const fechaSeleccionada = d.fechaPago || (opciones[0] ? opciones[0].value : '')
              if (!fechaSeleccionada) return

              const target = new Date(fechaSeleccionada + 'T00:00:00')
              const diff = Math.max(0, Math.floor((target - base) / 86400000))
              maxDias = Math.max(maxDias, diff)
              return
            }

            const mes = Number(cat.mesPagoTentativo) || 12
            const dia = Number(cat.diasPagoTentativo) || 1
            const base = new Date(this.fechaOtorgamiento + 'T00:00:00')
            let target = new Date(base.getFullYear(), mes - 1, dia)
            if (target <= base) target = new Date(base.getFullYear() + 1, mes - 1, dia)
            const diff = Math.max(0, Math.floor((target - base) / 86400000))
            maxDias = Math.max(maxDias, diff)
          })

          return maxDias
        },
        get mesesEstimados () {
          return Math.floor(this.plazoDiasEstimado / 30)
        },
        get diasEstimados () {
          return this.plazoDiasEstimado % 30
        },
        /**
         * @param { number } v
         * @returns { string }
         */
        formatCurrency (v) {
          return '$' + Number(v || 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          })
        },
        /**
         * @param { string } dateStr
         * @returns { string }
         */
        localize (dateStr) {
          if (!dateStr) return ''
          const p = String(dateStr).split('-')
          if (p.length !== 3) return dateStr
          return `${ p[2] }/${ p[1] }/${ p[0] }`
        },
        get puedeAgregar () {
          return this.categoriasTipoIngreso.some(c => c.activo && !this.selectedTipoIds.includes(c.id) && !this.fechaTentativaVencida(c))
        },
      }
    }

    // Exponer la función a Alpine.js
    window.simuladorData = simuladorData
  </script>
{/block}