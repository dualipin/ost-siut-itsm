{extends ../../../templates/@portal.latte}

{block main}
  <div class="container py-5">
    {include
      '../../../templates/components/header-page.latte',
      title: 'Solicitar Préstamo',
      description: 'Complete el formulario para solicitar un nuevo préstamo',
      icon: 'bi-file-earmark-text'
    }


    <div id="prestamo-root" data-user="{json_encode([
    'id' => $user->id,
    'name' => $user->name,
    'email' => $user->email,
    'rol'=> $user->role->value,
    ])|noescape}"></div>
  </div>
{/block}

{block scripts}
  {include parent}

  {vite('src/prestamo.tsx')|noescape}
{/block}