{extends ../../../templates/@portal.latte}

{block main}
  <!-- Encabezado Editorial Minimalista -->
  <header class="mb-5">
    <h1 class="h2 fw-bold text-dark mb-1">Noticias</h1>
    <p class="text-secondary mb-0">Mantente al tanto de las últimas novedades y acontecimientos de nuestro sindicato.</p>
  </header>

  <!-- Mensajes de Estado del Sistema -->
  {if $error}
    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center p-3 mb-4" role="alert">
      <i class="bi bi-exclamation-circle-fill text-danger me-3 fs-5"></i>
      <div class="small fw-semibold text-danger-emphasis">{$error}</div>
    </div>
  {/if}

  {if $success}
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center p-3 mb-4" role="alert">
      <i class="bi bi-check-circle-fill text-success me-3 fs-5"></i>
      <div class="small fw-semibold text-success-emphasis">{$success}</div>
    </div>
  {/if}

  <!-- Grid de Noticias Proporcional -->
  <div class="row g-4">
    {if count($noticias) > 0}
      {foreach $noticias as $noticia}
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 border-0 shadow-sm bg-white overflow-hidden">
            
            <!-- Contenedor de Imagen o Indicador Visual Alternativo -->
            {if $noticia['imagen_portada']}
              <div class="ratio ratio-16x9">
                <img src="{upload($noticia['imagen_portada'])}" class="object-fit-cover" alt="{$noticia['titulo']}">
              </div>
            {else}
              <!-- Placeholder sofisticado usando degradados nativos en vez de iconos gigantes -->
              <div class="ratio ratio-16x9 bg-secondary-subtle d-flex align-items-center justify-content-center">
                <span class="text-secondary small fw-medium text-opacity-50">Sindicato Noticia</span>
              </div>
            {/if}
            
            <!-- Contenido con Jerarquía Tipográfica Escaneable -->
            <div class="card-body p-4 d-flex flex-column">
              
              <!-- Metadatos de Publicación -->
              <div class="mb-2">
                <time class="text-secondary small fw-medium" datetime="{$noticia['fecha_publicacion']|date:'Y-m-d'}">
                  {$noticia['fecha_publicacion']|date:'d/m/Y'}
                </time>
              </div>
              
              <!-- Título de la Noticia (Stretched-link para hacer interactivo todo el bloque) -->
              <h2 class="card-title h5 text-dark fw-bold mb-2 lh-base">
                <a href="{url('/portal/publicaciones/noticias.php', ['detalle' => $noticia['id']])}" class="text-decoration-none text-dark stretched-link">
                  {$noticia['titulo']}
                </a>
              </h2>
              
              <!-- Resumen o Extracto -->
              <p class="card-text text-secondary small lh-relaxed mb-4 text-opacity-75">
                {$noticia['resumen']|truncate:120}
              </p>
              
              <!-- Indicador de Acción Sutil (Fija la posición visual al fondo de la card) -->
              <div class="mt-auto pt-2 text-primary fw-semibold small d-flex align-items-center gap-1">
                Leer noticia <i class="bi bi-arrow-right fs-6"></i>
              </div>

            </div>
          </article>
        </div>
      {/foreach}
    {else}
      <!-- Estado Vacío Semántico y Discreto -->
      <div class="col-12 py-5 text-center">
        <p class="text-secondary small mb-1">No hay noticias publicadas en este momento.</p>
        <span class="text-muted small">Vuelve más tarde para ver las actualizaciones.</span>
      </div>
    {/if}
  </div>
{/block}
