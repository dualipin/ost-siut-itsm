{extends ../../../templates/@portal.latte}

{block main}
  <!-- Encabezado Institucional Minucioso -->
  <header class="mb-5 pb-2 border-bottom">
    <h1 class="h2 fw-bold text-dark mb-1">Gestiones</h1>
    <p class="text-secondary mb-0">Información oficial sobre trámites, convenios y actividades realizadas por nuestro comité.</p>
  </header>

  <!-- Mensajes de Estado Estructurados -->
  {if $error}
    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center p-3 mb-4" role="alert">
      <i class="bi bi-exclamation-circle-fill me-3 fs-5"></i>
      <div class="small fw-medium">{$error}</div>
    </div>
  {/if}

  {if $success}
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center p-3 mb-4" role="alert">
      <i class="bi bi-check-circle-fill me-3 fs-5"></i>
      <div class="small fw-medium">{$success}</div>
    </div>
  {/if}

  <!-- Listado en Bloques Limpios (Diseño de Alta Densidad) -->
  <div class="row g-3">
    {if count($gestiones) > 0}
      {foreach $gestiones as $gestion}
        <div class="col-12">
          <article class="card border-0 shadow-sm bg-white position-relative">
            <div class="card-body p-4">
              <div class="row align-items-center g-3">
                
                  <!-- Columna Izquierda: Identificador Visual (Miniatura o Icono) & Metadata -->
                  <div class="col-12 col-md-auto d-flex align-items-center gap-3 border-end-md pe-4">
                    <div class="d-none d-sm-block flex-shrink-0">
                      {if $gestion['imagen_portada']}
                        <!-- Miniatura controlada y limpia -->
                        <div class="rounded-3 overflow-hidden bg-light border" style="width: 56px; height: 56px;">
                          <img src="{upload($gestion['imagen_portada'])}" class="w-100 h-100 object-fit-cover" alt="{$gestion['titulo']}">
                        </div>
                      {else}
                        <!-- Fallback con icono si no existe miniatura -->
                        <div class="p-3 bg-light text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                          <i class="bi bi-file-earmark-text fs-4"></i>
                        </div>
                      {/if}
                    </div>
                    <div>
                      <span class="badge text-primary-emphasis bg-primary-subtle border border-primary-subtle rounded-1 px-2 py-1 mb-1 small fw-semibold d-inline-block">
                        Trámite
                      </span>
                      <time class="d-block text-secondary small" datetime="{$gestion['fecha_publicacion']|date:'Y-m-d'}">
                        {$gestion['fecha_publicacion']|date:'d/m/Y'}
                      </time>
                    </div>
                  </div>


                <!-- Columna Central: Contenido Principal -->
                <div class="col">
                  <h2 class="h5 fw-bold text-dark mb-1">
                    <a href="{url('/portal/publicaciones/gestiones.php', ['detalle' => $gestion['id']])}" class="text-decoration-none text-dark stretched-link">
                      {$gestion['titulo']}
                    </a>
                  </h2>
                  <p class="text-secondary small mb-0 text-opacity-75">
                    {$gestion['resumen']|truncate:140}
                  </p>
                </div>

                <!-- Columna Derecha: Indicador de Acción -->
                <div class="col-12 col-md-auto text-md-end text-primary fw-medium small">
                  <span class="d-inline-flex align-items-center gap-1">
                    Ver Gestión <i class="bi bi-chevron-right fs-6"></i>
                  </span>
                </div>

              </div>
            </div>
          </article>
        </div>
      {/foreach}
    {else}
      <!-- Estado Vacío Sobrio -->
      <div class="col-12 text-center py-5">
        <p class="text-secondary small mb-1">No hay gestiones registradas en este momento.</p>
        <span class="text-muted small">Las actualizaciones del comité aparecerán en esta sección.</span>
      </div>
    {/if}
  </div>
{/block}
