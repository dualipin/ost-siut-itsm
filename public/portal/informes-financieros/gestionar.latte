{extends ../../../templates/@portal.latte}
{varType App\Modules\CashBoxes\Domain\Entity\AnnualFinancialReport[] $reports}
{varType ?string $message}
{varType ?string $error}

{block main}
  {include
    ../../../templates/components/header-page.latte,
    title => 'Gestionar informes financieros',
    description => 'Alta, edición y eliminación de informes anuales del portal.',
    icon => 'bi-file-earmark-plus'
  }

  <div class="d-flex justify-content-end mb-4">
    <a href="./nuevo.php" class="btn btn-primary rounded-pill px-4 shadow-sm">
      <i class="bi bi-upload me-2"></i>Nuevo informe
    </a>
  </div>

  {if $message}
    <div class="alert alert-success border-0 rounded-4 mb-4" role="alert">
      <i class="bi bi-check-circle me-2"></i>{$message}
    </div>
  {/if}

  {if $error}
    <div class="alert alert-danger border-0 rounded-4 mb-4" role="alert">
      <i class="bi bi-exclamation-triangle me-2"></i>{$error}
    </div>
  {/if}

  <div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-uppercase small text-muted">
          <tr>
            <th class="px-4 py-3 border-0">Año</th>
            {* <th class="px-4 py-3 border-0">Documento</th> *}
            <th class="px-4 py-3 border-0 text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {foreach $reports as $report}
            <tr class="transition-all">
              <td class="px-4 py-3 fw-bold text-dark">{$report->year}</td>
              {* <td class="px-4 py-3">
                <div class="d-flex flex-column">
                  <span class="fw-medium text-dark">{$report->fileName()}</span>
                  <small class="text-muted">{$report->document}</small>
                </div>
              </td> *}
              <td class="px-4 py-3 text-end">
                <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                  <a href="./ver.php?id={$report->id}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-eye me-1"></i>Ver
                  </a>
                  <a href="./actualizar.php?id={$report->id}" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-pencil me-1"></i>Editar
                  </a>
                  <form method="post" action="./eliminar.php" class="d-inline" onsubmit="return confirm('¿Deseas eliminar este informe financiero?');">
                    <input type="hidden" name="id" value="{$report->id}">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                      <i class="bi bi-trash me-1"></i>Eliminar
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {else}
            <tr>
              <td colspan="3" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                No hay informes registrados.
              </td>
            </tr>
          {/foreach}
        </tbody>
      </table>
    </div>
  </div>
{/block}