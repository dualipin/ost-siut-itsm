{extends ../../../templates/@portal.latte}
{varType App\Modules\CashBoxes\Domain\Entity\AnnualFinancialReport $report}
{varType bool $isPrivileged}
{varType bool $created}
{varType bool $updated}
{varType bool $isPdf}

{block main}
  {include
    ../../../templates/components/header-page.latte,
    title => 'Detalle del informe financiero',
    description => 'Consulta el archivo cargado para este ejercicio anual.',
    icon => 'bi-file-earmark-text'
  }

  {if $created}
    <div class="alert alert-success border-0 rounded-4 mb-4" role="alert">
      <i class="bi bi-check-circle me-2"></i>El informe se registró correctamente.
    </div>
  {/if}

  {if $updated}
    <div class="alert alert-success border-0 rounded-4 mb-4" role="alert">
      <i class="bi bi-check-circle me-2"></i>El informe se actualizó correctamente.
    </div>
  {/if}

  <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">
    <a href="./index.php" class="btn btn-outline-secondary rounded-pill px-4">
      <i class="bi bi-arrow-left me-2"></i>Volver
    </a>
    {if $isPrivileged}
      <a href="./actualizar.php?id={$report->id}" class="btn btn-outline-primary rounded-pill px-4">
        <i class="bi bi-pencil me-2"></i>Editar
      </a>
    {/if}
    <a href="{download($report->document)}" target="_blank" rel="noopener" class="btn btn-primary rounded-pill px-4 shadow-sm">
      <i class="bi bi-download me-2"></i>Descargar
    </a>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4 p-md-5">
          <h2 class="h5 fw-semibold text-secondary mb-4">Resumen</h2>
          <ul class="list-unstyled mb-0">
            <li class="mb-3">
              <span class="text-muted d-block small">Año</span>
              <span class="fw-bold fs-4 text-dark">{$report->year}</span>
            </li>
            <li class="mb-3">
              <span class="text-muted d-block small">Archivo</span>
              <span class="fw-semibold text-dark">{$report->fileName()}</span>
            </li>
            <li class="mb-0">
              <span class="text-muted d-block small">Ruta almacenada</span>
              <span class="text-break small text-muted">{$report->document}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4 p-md-5">
          <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <h2 class="h5 fw-semibold text-secondary mb-0">Documento</h2>
            <a href="./archivo.php?id={$report->id}" target="_blank" rel="noopener" class="btn btn-outline-primary rounded-pill px-4">
              <i class="bi bi-box-arrow-up-right me-2"></i>Abrir en nueva pestaña
            </a>
          </div>

          {if $isPdf}
            <div class="ratio ratio-16x9 border rounded-4 overflow-hidden bg-light mb-3">
              <iframe
                src="./archivo.php?id={$report->id}"
                title="Visor del informe financiero {$report->year}"
                loading="lazy"
                class="w-100 h-100 border-0"
              ></iframe>
            </div>
            <div class="alert alert-light border rounded-4 mb-0">
              <div class="d-flex align-items-start gap-3">
                <i class="bi bi-file-earmark-pdf text-danger fs-3"></i>
                <div>
                  <div class="fw-semibold text-dark">Vista previa disponible</div>
                  <small class="text-muted">Puedes revisar el PDF sin salir de la página.</small>
                </div>
              </div>
            </div>
          {else}
            <div class="p-4 bg-light rounded-4 border">
              <div class="d-flex align-items-start gap-3">
                <div class="flex-shrink-0">
                  <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                    <i class="bi bi-file-earmark-arrow-down me-1"></i>Informe anual
                  </span>
                </div>
                <div class="flex-grow-1">
                  <p class="mb-2 text-dark fw-medium">El archivo cargado está disponible para descarga segura.</p>
                  <a href="{download($report->document)}" target="_blank" rel="noopener" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-download me-2"></i>Descargar documento
                  </a>
                </div>
              </div>
            </div>
          {/if}
        </div>
      </div>
    </div>
  </div>
{/block}